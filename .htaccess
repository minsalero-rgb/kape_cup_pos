<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\.mcp\.json|\.env(?:\..*)?|.*\.(?:md|sql|ps1|dump|log|bak|zip|cnf|ini))$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    # Enable ONLY after HTTPS works in production:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
